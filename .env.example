# Sentinel AI - Environment Configuration Example
# Copy this file to '.env' and fill in your actual OpenAI API key.
# IMPORTANT: Never commit your real '.env' file or API key to version control!

# Your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use (default: gpt-4o-mini for fast, cost-effective responses)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Server Port (default: 3000)
PORT=3000
